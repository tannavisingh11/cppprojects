#include <iostream>
#include <stack>
#include <algorithm>
using namespace std;
//character precedence checking
int prec(char c) {
    if (c == '^')
    return 3;
    if (c == '*' || c == '/') 
    return 2;
    if (c == '+' || c == '-')
    return 1;
    
    return 0;
}

int main() {
    string infix, prefix = "";
    cout << "Enter infix: ";
    cin >> infix;

    reverse(infix.begin(), infix.end());

    for (int i = 0; i < infix.size(); i++) {
        if (infix[i] == '(') infix[i] = ')';
        else if (infix[i] == ')') infix[i] = '(';
    }

    stack<char> st;

    for (char ch : infix) {
        if (isalnum(ch))
            prefix += ch;
        else if (ch == '(')
            st.push(ch);
        else if (ch == ')') {
            while (!st.empty() && st.top() != '(') {
                prefix += st.top();
                st.pop();
            }
            st.pop();
        } else {
            while (!st.empty() && prec(st.top()) >= prec(ch)) {
                prefix += st.top();
                st.pop();
            }
            st.push(ch);
        }
    }

    while (!st.empty()) {
        prefix += st.top();
        st.pop();
    }

    reverse(prefix.begin(), prefix.end());

    cout << "Prefix = " << prefix;
    return 0;
}